bindkey -e
# deleteキーがチルダになってしまうのを避ける
bindkey "^[[3~" delete-char

[ -f "$HOME/.config/zsh/.zshrc" ] && source "$HOME/.config/zsh/.zshrc"

export LANG=ja_JP.UTF-8
# export TERM=tmux-256color
export TERM=xterm-256color

export EDITOR=nvim

source "$HOME/.zsh_prompt"

export PATH="$PATH:$HOME/.tools"
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"

# abbr
source "$HOME/.zsh_abbr" >/dev/null

source "$HOME/.zsh_alias" >/dev/null
source "$HOME/.zsh_function" >/dev/null

# zoxide
eval "$(zoxide init zsh --cmd cd)"

# uv
eval "$(uv generate-shell-completion zsh)"
export PATH="$HOME/.local/bin:$PATH"

# direnv
eval "$(direnv hook zsh)"

# WSL
export BROWSER="/mnt/c/Windows/System32/rundll32.exe url.dll,FileProtocolHandler"

# pnpm
export PNPM_HOME="/home/zaki3mymy/.local/share/pnpm"
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Go
export PATH="$(go env GOBIN):$PATH"
